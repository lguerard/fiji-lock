Bootstrap: docker
# A plain base image: `restore` installs the exact JDK recorded in fiji.lock.json
# into /opt/Fiji/java/linux64/, and the Fiji launcher finds it there.
# (If your lockfile has no "java.packages" -- e.g. a non-Zulu or Fiji Stable JDK --
#  use a JDK base image instead, such as azul/zulu-openjdk:21, and add --no-java.)
# For full reproducibility, pin the base image by digest (debian@sha256:...).
From: debian:bookworm-slim
# If `lock` reported no local-only/modified files, delete the fiji.local.zip line in %files.

%files
    fiji_lock.py     /opt/fiji-lock/fiji_lock.py
    fiji.lock.json   /opt/fiji-lock/fiji.lock.json
    fiji.local.zip   /opt/fiji-lock/fiji.local.zip

%post
    set -e
    apt-get update
    apt-get install -y --no-install-recommends python3 ca-certificates fontconfig libfreetype6 libxrender1 libxtst6 libxi6
    rm -rf /var/lib/apt/lists/*

    BUNDLE=""
    [ -f /opt/fiji-lock/fiji.local.zip ] && BUNDLE="--local-bundle /opt/fiji-lock/fiji.local.zip"
    python3 /opt/fiji-lock/fiji_lock.py restore /opt/fiji-lock/fiji.lock.json /opt/Fiji \
        --platform linux64 $BUNDLE
    python3 /opt/fiji-lock/fiji_lock.py verify /opt/fiji-lock/fiji.lock.json /opt/Fiji --platform linux64

%runscript
    # Fiji Latest uses the Jaunch launcher; Fiji Stable the old ImageJ launcher.
    if [ -x /opt/Fiji/fiji-linux-x64 ]; then
        exec /opt/Fiji/fiji-linux-x64 --headless "$@"
    else
        exec /opt/Fiji/ImageJ-linux64 --headless "$@"
    fi

%help
    Fiji rebuilt from fiji.lock.json, including its locked JDK. Example:
      apptainer run fiji.sif --console --run /path/to/script.groovy 'input="/data/x.tif"'
    The lockfile used for this build is at /opt/fiji-lock/fiji.lock.json.
